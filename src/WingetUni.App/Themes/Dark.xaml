<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1B1B1F" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#141417" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#202024" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#26262B" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#2E2E35" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2A2A30" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2E3B57" />

    <SolidColorBrush x:Key="ForegroundBrush" Color="#F2F2F5" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#B4B4BE" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#83838D" />

    <SolidColorBrush x:Key="BorderBrush" Color="#34343B" />

    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C8FF7" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2F6FD6" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F85149" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D29922" />

</ResourceDictionary>
