<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#EAEBEF" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F0F1F4" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#DCE6FF" />

    <SolidColorBrush x:Key="ForegroundBrush" Color="#1B1B1F" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#4B4B55" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#6E6E78" />

    <SolidColorBrush x:Key="BorderBrush" Color="#D4D6DD" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3B7BF0" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1D4FBF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#CF222E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />

</ResourceDictionary>
