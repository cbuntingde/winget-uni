<Window x:Class="WingetUni.App.Views.InstallOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WingetUni.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:InstallOptionsViewModel}"
        Title="{Binding WindowTitle}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource ForegroundBrush}"
        Background="{DynamicResource WindowBackgroundBrush}">

    <StackPanel Margin="22">
        <TextBlock Text="{Binding PackageName}"
                   Style="{DynamicResource TitleText}"
                   FontSize="19"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding PackageId}" Style="{DynamicResource CaptionText}" Margin="0,2,0,0" />
        <TextBlock Text="{Binding ManagerName}" Style="{DynamicResource CaptionText}" />

        <TextBlock Text="{Binding VersionLabel}" Margin="0,18,0,4" />
        <TextBox Text="{Binding Version, UpdateSourceTrigger=LostFocus}" />

        <TextBlock Text="Scope" Margin="0,14,0,2" />
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="Default" GroupName="Scope" IsChecked="{Binding IsDefaultScope}" />
            <RadioButton Content="Current user" GroupName="Scope" IsChecked="{Binding IsUserScope}" Margin="18,4,0,4" />
            <RadioButton Content="All users" GroupName="Scope" IsChecked="{Binding IsMachineScope}" Margin="18,4,0,4" />
        </StackPanel>

        <TextBlock Text="Install location" Margin="0,14,0,4" />
        <TextBox Text="{Binding Location, UpdateSourceTrigger=LostFocus}" />

        <TextBlock Text="Extra arguments for the installer" Margin="0,14,0,4" />
        <TextBox Text="{Binding CustomArguments, UpdateSourceTrigger=LostFocus}" />
        <TextBlock Text="Passed to the manager unchanged, exactly as typed."
                   Style="{DynamicResource CaptionText}"
                   Margin="0,4,0,0" />

        <CheckBox Content="Unattended install"
                  IsChecked="{Binding Silent}"
                  Margin="0,14,0,0" />
        <CheckBox Content="Accept source and package agreements"
                  IsChecked="{Binding AcceptAgreements}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel"
                    IsCancel="True"
                    MinWidth="90" />
            <Button Content="{Binding ConfirmLabel}"
                    Style="{DynamicResource PrimaryButton}"
                    IsDefault="True"
                    Click="OnAccept"
                    Margin="8,0,0,0"
                    MinWidth="110" />
        </StackPanel>
    </StackPanel>
</Window>
