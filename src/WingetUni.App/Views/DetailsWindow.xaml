<Window x:Class="WingetUni.App.Views.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WingetUni.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PackageDetailsViewModel}"
        Title="{Binding Name}"
        Width="680"
        Height="640"
        MinWidth="460"
        MinHeight="380"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource ForegroundBrush}"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <DataTemplate x:Key="DetailFieldRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Key}"
                           Style="{DynamicResource CaptionText}"
                           VerticalAlignment="Top" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Value}"
                           Style="{DynamicResource BodyText}"
                           VerticalAlignment="Top" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Name}"
                       Style="{DynamicResource TitleText}"
                       FontSize="20"
                       TextWrapping="Wrap" />
            <TextBlock Style="{DynamicResource CaptionText}" Margin="0,3,0,0">
                <Run Text="{Binding Id, Mode=OneWay}" />
                <Run Text="  ·  " />
                <Run Text="{Binding ManagerName, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <Border Style="{DynamicResource Card}"
                        Padding="14"
                        Margin="0,0,0,12"
                        Visibility="{Binding Description, Converter={StaticResource NotEmptyToVisibility}}">
                    <TextBlock Text="{Binding Description}"
                               Style="{DynamicResource BodyText}"
                               LineHeight="19" />
                </Border>

                <ItemsControl ItemsSource="{Binding Summary}"
                              ItemTemplate="{StaticResource DetailFieldRow}"
                              Margin="0,0,0,12" />

                <TextBlock Text="Tags"
                           Style="{DynamicResource SectionText}"
                           Margin="0,4,0,4"
                           Visibility="{Binding TagsText, Converter={StaticResource NotEmptyToVisibility}}" />
                <TextBlock Text="{Binding TagsText}"
                           Style="{DynamicResource MutedText}"
                           Margin="0,0,0,12"
                           Visibility="{Binding TagsText, Converter={StaticResource NotEmptyToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Documentation}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Everything this manager reported"
                           Style="{DynamicResource SectionText}"
                           Margin="0,4,0,4" />
                <ItemsControl ItemsSource="{Binding Fields}"
                              ItemTemplate="{StaticResource DetailFieldRow}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Open homepage"
                    Click="OnOpenHomepage"
                    MinWidth="130"
                    Visibility="{Binding Homepage, Converter={StaticResource NotEmptyToVisibility}}" />
            <Button Content="Close"
                    Style="{DynamicResource PrimaryButton}"
                    IsDefault="True"
                    IsCancel="True"
                    Margin="8,0,0,0"
                    MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>
