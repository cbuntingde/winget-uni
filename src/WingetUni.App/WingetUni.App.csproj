<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WingetUni.Core\WingetUni.Core.csproj" />
    <ProjectReference Include="..\WingetUni.Providers\WingetUni.Providers.csproj" />
  </ItemGroup>

  <!--
    The tray icon needs WinForms, but its implicit global usings bring in names, such as
    Application and UserControl, that WPF also defines. Removing them keeps the WPF code
    unambiguous; the one file that uses WinForms imports it through an alias instead.
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The executable's icon: what Windows shows in the taskbar, Alt+Tab, and Explorer. -->
    <ApplicationIcon>Assets\WingetUni.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Also embedded as a resource so the window and tray icon can load the same image. -->
  <ItemGroup>
    <Resource Include="Assets\WingetUni.ico" />
  </ItemGroup>

</Project>
