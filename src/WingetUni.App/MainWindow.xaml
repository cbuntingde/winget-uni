<Window x:Class="WingetUni.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WingetUni.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Winget Uni"
        Icon="/Assets/WingetUni.ico"
        Height="780"
        Width="1200"
        MinHeight="560"
        MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource RailBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,24,20,18">
                    <TextBlock Text="Winget Uni" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="One place for your package managers"
                               Style="{DynamicResource CaptionText}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton Style="{DynamicResource NavRadioButton}"
                                 GroupName="Nav"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="installed"
                                 IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EqualsToBoolean}, ConverterParameter=installed}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="Installed" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{DynamicResource NavRadioButton}"
                                 GroupName="Nav"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="discover"
                                 IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EqualsToBoolean}, ConverterParameter=discover}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="Discover" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{DynamicResource NavRadioButton}"
                                 GroupName="Nav"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="updates"
                                 IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EqualsToBoolean}, ConverterParameter=updates}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="Updates" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{DynamicResource NavRadioButton}"
                                 GroupName="Nav"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="settings"
                                 IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EqualsToBoolean}, ConverterParameter=settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="10,0,10,0">
                    <Separator />

                    <Button HorizontalContentAlignment="Left"
                            Command="{Binding ToggleThemeCommand}"
                            Margin="0,4,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Theme:" />
                            <TextBlock Text="{Binding ThemeLabel}" Margin="5,0,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button Content="Show operations"
                            HorizontalContentAlignment="Left"
                            Command="{Binding ToggleOperationsCommand}"
                            Margin="0,0,0,4" />

                    <Button Content="Exit"
                            HorizontalContentAlignment="Left"
                            Command="{Binding ExitCommand}"
                            Margin="0,0,0,12" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,22,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding SectionTitle}"
                           Style="{DynamicResource TitleText}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Working&#x2026;"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="Check for updates"
                            Style="{DynamicResource PrimaryButton}"
                            Command="{Binding CheckUpdatesCommand}"
                            MinWidth="160" />
                </StackPanel>
            </Grid>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding ShowOperations, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="24,14" Height="210">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Operations"
                                   Style="{DynamicResource SectionText}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Clear"
                                    Command="{Binding ClearOperationsCommand}" />
                            <Button Content="Hide"
                                    Command="{Binding ToggleOperationsCommand}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Operations}"
                                      ItemTemplate="{DynamicResource OperationItem}" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,8">
                <Grid>
                    <TextBlock Text="{Binding Status}"
                               Style="{DynamicResource MutedText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,140,0" />

                    <Button Content="Cancel current"
                            HorizontalAlignment="Right"
                            Command="{Binding CancelCurrentCommand}"
                            Visibility="{Binding IsQueueRunning, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
